# Set these in the shell or your hosting provider. Django does not automatically read this file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-new-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_ENGINE=sqlite
SQLITE_NAME=dev.sqlite3
# PostgreSQL: omit DB_ENGINE and supply DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT.
# Set new Razorpay test credentials to exercise payment checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional shared Redis cache:
REDIS_URL=
